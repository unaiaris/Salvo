ASPNETCORE_URLS=http://127.0.0.1:5100
ConnectionStrings__SalvoDb=Data Source=salvo.db
SALVO_API_BASE_URL=http://127.0.0.1:5100

# The one language this deployment writes explanations in and renders its console in: es or pt.
# Read only by the API, which refuses to start on any other value and publishes what it parsed in
# GET /api/system/capabilities. The console takes it from there and never reads this variable, so a
# Portuguese console around a Spanish paragraph cannot happen. Unset is the same as es, which is the
# default and the language of the demonstration.
SALVO_LANGUAGE=es

# Shared secret an external provider presents in the X-Salvo-Callback-Secret header of
# POST /api/external-callbacks/{provider}. Empty means closed: every callback is refused with 401.
# Backend only. Never NEXT_PUBLIC_, and never read by the Next process.
# This is not the mechanism a real integration would use; see section 5.3 of the Blueprint.
SALVO_CALLBACK_SHARED_SECRET=

AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

KOIN_MODE=mock
KOIN_BASE_URL=https://api-sandbox.koin.com.br
KOIN_PRIVATE_KEY=
KOIN_ORG_ID=
KOIN_STORE_CODE=
KOIN_CALLBACK_URL=
KOIN_CALLBACK_SHARED_SECRET=
