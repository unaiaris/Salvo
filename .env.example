ConnectionStrings__SalvoDb=Data Source=salvo.db
SALVO_API_BASE_URL=http://127.0.0.1:5100
BUSINESS_TIMEZONE=America/Montevideo

# Shared secret an external provider presents in the X-Salvo-Callback-Secret header of
# POST /api/external-callbacks/{provider}. Empty means closed: every callback is refused with 401.
# Backend only. Never NEXT_PUBLIC_, and never read by the Next process.
# This is not the mechanism a real integration would use; see section 5.3 of the Blueprint.
SALVO_CALLBACK_SHARED_SECRET=

AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

